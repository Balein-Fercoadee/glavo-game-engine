<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:gameData="clr-namespace:GameEngine.GameData;assembly=GameEngine"
             x:Class="GameDatabaseEditor.Views.MessageEditorView"
             x:DataType="gameData:Message"
             WidthRequest="500">
    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
        <Label Grid.Row="0" Grid.Column="0" Text="ID:" />
        <Label Grid.Row="0" Grid.Column="1" Text="{Binding Id}" />

        <Label Grid.Row="1" Grid.Column="0" Text="Text:" />
        <Editor Grid.Row="1" Grid.Column="1" Text="{Binding Text}" HeightRequest="100" />
    </Grid>
</ContentView>

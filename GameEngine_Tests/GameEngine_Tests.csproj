    <Compile Include="..\GameDatabaseEditor\Utilities\RoomReferences.cs" Link="RoomReferences.cs" />
    <Compile Include="..\GameDatabaseEditor\Utilities\WordEditSession.cs" Link="WordEditSession.cs" />
    <Compile Include="..\GameDatabaseEditor\Utilities\WordReferences.cs" Link="WordReferences.cs" />
    <Compile Include="..\GameDatabaseEditor\Utilities\WordValidation.cs" Link="WordValidation.cs" />
    <Compile Include="..\GameDatabaseEditor\Utilities\GeneralUtilities.cs" Link="GeneralUtilities.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="test_data\fake_game.gge">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="test_data\fake_save.gges">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="test_data\test_game_database.gge">
